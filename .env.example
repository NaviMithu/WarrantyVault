# Supabase Project Configuration
# Replace with your actual project URL and public anon key from Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Single user credentials for silent background login
# Create this user in Supabase Dashboard > Authentication > Users
SUPABASE_USER_EMAIL=user@example.com
SUPABASE_USER_PASSWORD=your-secure-password-here
